# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- Anthropic (required) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- LangSmith tracing (optional) ---
# Get a key at https://smith.langchain.com/ -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-key-here
LANGSMITH_PROJECT=geopolitical-news-agent
# Default is the US endpoint. For the EU region use https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
